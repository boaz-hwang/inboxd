{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inboxd SQLCipher Spike Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spike",
    "observedAt",
    "sqlCipherVersion",
    "outcomes"
  ],
  "properties": {
    "spike": { "const": "0-encryption" },
    "observedAt": { "type": "string", "format": "date-time" },
    "sqlCipherVersion": { "type": "string", "minLength": 1 },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctKeyReopenWithFts",
        "missingKeyRejected",
        "wrongKeyRejected",
        "ordinaryBunSqliteRejected",
        "walPathObserved",
        "plaintextHeaderRejected",
        "unsetSqlCipherPathRejected",
        "invalidSqlCipherPathRejected"
      ],
      "properties": {
        "correctKeyReopenWithFts": { "const": true },
        "missingKeyRejected": { "const": true },
        "wrongKeyRejected": { "const": true },
        "ordinaryBunSqliteRejected": { "const": true },
        "walPathObserved": { "const": true },
        "plaintextHeaderRejected": { "const": true },
        "unsetSqlCipherPathRejected": { "const": true },
        "invalidSqlCipherPathRejected": { "const": true }
      }
    }
  }
}
