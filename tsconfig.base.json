{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["packages/**/*.ts", "platforms/**/*.ts", "contrib/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
